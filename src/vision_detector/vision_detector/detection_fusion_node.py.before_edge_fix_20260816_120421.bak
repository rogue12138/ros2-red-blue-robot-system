#!/usr/bin/env python3

import copy

import message_filters
import rclpy

from rclpy.node import Node

from robot_interfaces.msg import ObjectDetection
from robot_interfaces.msg import ObjectDetectionArray


ALLOWED_CLASSES = {
    "red_cube",
    "blue_cube",
}


class DetectionFusionNode(Node):

    def __init__(self):
        super().__init__("detection_fusion_node")

        self.declare_parameter(
            "hsv_topic",
            "/vision/detections",
        )
        self.declare_parameter(
            "yolo_topic",
            "/vision/yolo_detections",
        )
        self.declare_parameter(
            "output_topic",
            "/vision/fused_detections",
        )
        self.declare_parameter(
            "synchronization_queue_size",
            100,
        )
        self.declare_parameter(
            "synchronization_slop_sec",
            0.08,
        )
        self.declare_parameter(
            "match_iou_threshold",
            0.20,
        )
        self.declare_parameter(
            "duplicate_iou_threshold",
            0.50,
        )
        self.declare_parameter(
            "minimum_hsv_confidence",
            0.50,
        )
        self.declare_parameter(
            "minimum_yolo_confidence",
            0.05,
        )
        self.declare_parameter(
            "prefer_hsv_box",
            True,
        )
        self.declare_parameter(
            "log_every_n_messages",
            10,
        )

        self.hsv_topic = str(
            self.get_parameter("hsv_topic").value
        )
        self.yolo_topic = str(
            self.get_parameter("yolo_topic").value
        )
        self.output_topic = str(
            self.get_parameter("output_topic").value
        )

        self.synchronization_queue_size = int(
            self.get_parameter(
                "synchronization_queue_size"
            ).value
        )
        self.synchronization_slop_sec = float(
            self.get_parameter(
                "synchronization_slop_sec"
            ).value
        )
        self.match_iou_threshold = float(
            self.get_parameter(
                "match_iou_threshold"
            ).value
        )
        self.duplicate_iou_threshold = float(
            self.get_parameter(
                "duplicate_iou_threshold"
            ).value
        )
        self.minimum_hsv_confidence = float(
            self.get_parameter(
                "minimum_hsv_confidence"
            ).value
        )
        self.minimum_yolo_confidence = float(
            self.get_parameter(
                "minimum_yolo_confidence"
            ).value
        )
        self.prefer_hsv_box = bool(
            self.get_parameter(
                "prefer_hsv_box"
            ).value
        )
        self.log_every_n_messages = int(
            self.get_parameter(
                "log_every_n_messages"
            ).value
        )

        if self.synchronization_queue_size < 2:
            self.synchronization_queue_size = 2

        if self.synchronization_slop_sec <= 0.0:
            self.synchronization_slop_sec = 0.08

        if self.log_every_n_messages < 1:
            self.log_every_n_messages = 1

        self.validate_threshold(
            "match_iou_threshold",
            self.match_iou_threshold,
        )
        self.validate_threshold(
            "duplicate_iou_threshold",
            self.duplicate_iou_threshold,
        )
        self.validate_threshold(
            "minimum_hsv_confidence",
            self.minimum_hsv_confidence,
        )
        self.validate_threshold(
            "minimum_yolo_confidence",
            self.minimum_yolo_confidence,
        )

        self.fused_publisher = self.create_publisher(
            ObjectDetectionArray,
            self.output_topic,
            10,
        )

        self.hsv_subscriber = (
            message_filters.Subscriber(
                self,
                ObjectDetectionArray,
                self.hsv_topic,
            )
        )

        self.yolo_subscriber = (
            message_filters.Subscriber(
                self,
                ObjectDetectionArray,
                self.yolo_topic,
            )
        )

        self.synchronizer = (
            message_filters.ApproximateTimeSynchronizer(
                [
                    self.hsv_subscriber,
                    self.yolo_subscriber,
                ],
                queue_size=(
                    self.synchronization_queue_size
                ),
                slop=self.synchronization_slop_sec,
            )
        )

        self.synchronizer.registerCallback(
            self.fusion_callback
        )

        self.message_count = 0

        self.get_logger().info(
            "HSV+YOLO检测融合节点已启动："
            f"HSV={self.hsv_topic}，"
            f"YOLO={self.yolo_topic}，"
            f"输出={self.output_topic}"
        )

    def validate_threshold(
        self,
        name,
        value,
    ):
        if not 0.0 <= value <= 1.0:
            raise ValueError(
                f"{name}必须位于0到1之间"
            )

    def calculate_iou(
        self,
        first,
        second,
    ):
        intersection_x_min = max(
            int(first.x_min),
            int(second.x_min),
        )
        intersection_y_min = max(
            int(first.y_min),
            int(second.y_min),
        )
        intersection_x_max = min(
            int(first.x_max),
            int(second.x_max),
        )
        intersection_y_max = min(
            int(first.y_max),
            int(second.y_max),
        )

        intersection_width = max(
            0,
            intersection_x_max
            - intersection_x_min,
        )
        intersection_height = max(
            0,
            intersection_y_max
            - intersection_y_min,
        )

        intersection_area = float(
            intersection_width
            * intersection_height
        )

        first_area = float(
            max(0, int(first.x_max) - int(first.x_min))
            * max(
                0,
                int(first.y_max) - int(first.y_min),
            )
        )
        second_area = float(
            max(
                0,
                int(second.x_max) - int(second.x_min),
            )
            * max(
                0,
                int(second.y_max) - int(second.y_min),
            )
        )

        union_area = (
            first_area
            + second_area
            - intersection_area
        )

        if union_area <= 0.0:
            return 0.0

        return intersection_area / union_area

    def valid_detection(
        self,
        detection,
        minimum_confidence,
    ):
        if detection.class_name not in ALLOWED_CLASSES:
            return False

        if detection.confidence < minimum_confidence:
            return False

        if detection.x_max <= detection.x_min:
            return False

        if detection.y_max <= detection.y_min:
            return False

        return True

    def merge_detection(
        self,
        hsv_detection,
        yolo_detection,
    ):
        if self.prefer_hsv_box:
            merged = copy.deepcopy(
                hsv_detection
            )
        else:
            merged = copy.deepcopy(
                yolo_detection
            )

            hsv_weight = float(
                hsv_detection.confidence
            )
            yolo_weight = float(
                yolo_detection.confidence
            )
            total_weight = (
                hsv_weight + yolo_weight
            )

            if total_weight > 0.0:
                merged.x_min = int(round(
                    (
                        hsv_detection.x_min
                        * hsv_weight
                        + yolo_detection.x_min
                        * yolo_weight
                    )
                    / total_weight
                ))
                merged.y_min = int(round(
                    (
                        hsv_detection.y_min
                        * hsv_weight
                        + yolo_detection.y_min
                        * yolo_weight
                    )
                    / total_weight
                ))
                merged.x_max = int(round(
                    (
                        hsv_detection.x_max
                        * hsv_weight
                        + yolo_detection.x_max
                        * yolo_weight
                    )
                    / total_weight
                ))
                merged.y_max = int(round(
                    (
                        hsv_detection.y_max
                        * hsv_weight
                        + yolo_detection.y_max
                        * yolo_weight
                    )
                    / total_weight
                ))

        hsv_confidence = min(
            1.0,
            max(0.0, float(
                hsv_detection.confidence
            )),
        )
        yolo_confidence = min(
            1.0,
            max(0.0, float(
                yolo_detection.confidence
            )),
        )

        merged.confidence = float(
            1.0
            - (
                1.0 - hsv_confidence
            )
            * (
                1.0 - yolo_confidence
            )
        )

        merged.has_position = False
        merged.position.x = 0.0
        merged.position.y = 0.0
        merged.position.z = 0.0

        return merged

    def remove_duplicates(
        self,
        detections,
    ):
        ordered = sorted(
            detections,
            key=lambda detection: float(
                detection.confidence
            ),
            reverse=True,
        )

        kept = []

        for detection in ordered:
            duplicate = False

            for existing in kept:
                if (
                    detection.class_name
                    != existing.class_name
                ):
                    continue

                if (
                    self.calculate_iou(
                        detection,
                        existing,
                    )
                    >= self.duplicate_iou_threshold
                ):
                    duplicate = True
                    break

            if not duplicate:
                kept.append(detection)

        kept.sort(
            key=lambda detection: (
                detection.class_name,
                int(detection.x_min),
                int(detection.y_min),
            )
        )

        for index, detection in enumerate(
            kept,
            start=1,
        ):
            center_x = int(round(
                (
                    int(detection.x_min)
                    + int(detection.x_max)
                )
                / 2.0
            ))
            center_y = int(round(
                (
                    int(detection.y_min)
                    + int(detection.y_max)
                )
                / 2.0
            ))

            if hasattr(
                detection,
                "detection_id",
            ):
                detection.detection_id = index

            if hasattr(
                detection,
                "center_x",
            ):
                detection.center_x = center_x

            if hasattr(
                detection,
                "center_y",
            ):
                detection.center_y = center_y

            if hasattr(
                detection,
                "center_u",
            ):
                detection.center_u = center_x

            if hasattr(
                detection,
                "center_v",
            ):
                detection.center_v = center_y

        return kept

    def fusion_callback(
        self,
        hsv_message,
        yolo_message,
    ):
        hsv_detections = [
            copy.deepcopy(detection)
            for detection
            in hsv_message.detections
            if self.valid_detection(
                detection,
                self.minimum_hsv_confidence,
            )
        ]

        yolo_detections = [
            copy.deepcopy(detection)
            for detection
            in yolo_message.detections
            if self.valid_detection(
                detection,
                self.minimum_yolo_confidence,
            )
        ]

        fused_candidates = []
        used_yolo_indices = set()
        matched_count = 0

        for hsv_detection in hsv_detections:
            best_index = None
            best_iou = 0.0

            for index, yolo_detection in enumerate(
                yolo_detections
            ):
                if index in used_yolo_indices:
                    continue

                if (
                    hsv_detection.class_name
                    != yolo_detection.class_name
                ):
                    continue

                current_iou = self.calculate_iou(
                    hsv_detection,
                    yolo_detection,
                )

                if current_iou > best_iou:
                    best_iou = current_iou
                    best_index = index

            if (
                best_index is not None
                and best_iou
                >= self.match_iou_threshold
            ):
                fused_candidates.append(
                    self.merge_detection(
                        hsv_detection,
                        yolo_detections[
                            best_index
                        ],
                    )
                )
                used_yolo_indices.add(
                    best_index
                )
                matched_count += 1
            else:
                hsv_detection.has_position = False
                hsv_detection.position.x = 0.0
                hsv_detection.position.y = 0.0
                hsv_detection.position.z = 0.0

                fused_candidates.append(
                    hsv_detection
                )

        for index, yolo_detection in enumerate(
            yolo_detections
        ):
            if index in used_yolo_indices:
                continue

            yolo_detection.has_position = False
            yolo_detection.position.x = 0.0
            yolo_detection.position.y = 0.0
            yolo_detection.position.z = 0.0

            fused_candidates.append(
                yolo_detection
            )

        fused_detections = (
            self.remove_duplicates(
                fused_candidates
            )
        )

        output_message = (
            ObjectDetectionArray()
        )
        output_message.header = (
            yolo_message.header
        )
        output_message.detections = (
            fused_detections
        )

        self.fused_publisher.publish(
            output_message
        )

        self.message_count += 1

        if (
            self.message_count
            % self.log_every_n_messages
            == 0
        ):
            red_count = sum(
                detection.class_name
                == "red_cube"
                for detection
                in fused_detections
            )
            blue_count = sum(
                detection.class_name
                == "blue_cube"
                for detection
                in fused_detections
            )

            self.get_logger().info(
                "融合检测结果："
                f"HSV={len(hsv_detections)}，"
                f"YOLO={len(yolo_detections)}，"
                f"匹配={matched_count}，"
                f"融合后={len(fused_detections)}，"
                f"red_cube={red_count}，"
                f"blue_cube={blue_count}"
            )


def main(args=None):
    rclpy.init(args=args)

    node = DetectionFusionNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
