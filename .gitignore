/build/
/install/
/log/

# 本机Python虚拟环境，不可跨电脑直接复制使用
/venvs/

# Python缓存
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 编辑器和系统临时文件
*~
*.swp
*.swo
.DS_Store
Thumbs.db

# 本机运行缓存
*.cache
labelImgSettings.pkl
core
core.*

# 密钥和本机环境变量
.env
.env.*
!.env.example
*.pem
*.key

# ROS运行时临时目录
.ros/
